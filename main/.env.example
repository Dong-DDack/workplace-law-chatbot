# Copy this file to .env and fill in the values locally.
# Never commit .env or paste secret values into browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-side Supabase connection. Never expose the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional locally; required when NODE_ENV=production. Keep this out of GitHub.
APP_ACCESS_USERNAME=tester
APP_ACCESS_PASSWORD=
