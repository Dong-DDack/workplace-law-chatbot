# Copy this file to .env and fill in the values locally.
# Never commit .env or paste secret values into browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-side Supabase connection. Never expose the Secret key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Safe to expose to the browser; used only to start Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Optional comma-separated Google email allowlist. Leave empty to allow any Google account.
APP_ALLOWED_EMAILS=
APP_DAILY_CHAT_LIMIT=10
APP_GLOBAL_DAILY_CHAT_LIMIT=30
